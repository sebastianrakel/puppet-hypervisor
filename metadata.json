{
  "name": "puppet-hypervisor",
  "version": "0.1.0-rc0",
  "author": "Sebastian Rakel",
  "summary": "OpenVox Hypervisor Modul",
  "license": "AGPL-3.0",
  "source": "https://github.com/sebastianrakel/puppet-hypervisor",
  "project_page": "https://github.com/sebastianrakel/puppet-hypervisor",
  "issues_url": "https://github.com/sebastianrakel/puppet-hypervisor/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 10.0.0"
    },
    {
      "name": "cirrax/libvirt",
      "version_requirement": ">= 6.0.0 < 7.0.0"
    },
    {
      "name": "puppet/systemd",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ]
}
